# ============================================
# Configuración de zsh-functions
# ============================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo a .env: cp .env.example .env
# 2. Edita .env con tus valores reales
# 3. El archivo .env NO se subirá al repositorio (está en .gitignore)
#
# NOTA: Este archivo contiene valores de ejemplo/dummy
# ============================================

# ============================================
# Configuración de Deployment (Quicksilver)
# ============================================

# URL base del servidor de Quicksilver
export DEPLOY_SERVER_URL="https://your-deployment-server.example.com"

# Aplicaciones en Quicksilver (formato: "id_app:nombre-app")
# El nombre de la app debe estar en kebab-case
# Cada aplicación tiene un ID y un nombre único
export DEPLOY_APPS=(
  "YOUR_APP_ID:your-app-name"
  # "ANOTHER_APP_ID:another-app"
)

# Servicios disponibles (formato: "id:nombre:nombre-app")
# Cada servicio debe definirse como "id-del-servicio:nombre-del-servicio:nombre-de-la-app"
# El nombre de la app debe coincidir con uno definido en DEPLOY_APPS
# Los nombres se usarán como comando: deploy <nombre>
export DEPLOY_SERVICES=(
  "YOUR_SECURITY_SERVICE_ID:security:your-app-name"
  "YOUR_LOGIN_SERVICE_ID:login:your-app-name"
  "YOUR_LOGOUT_SERVICE_ID:logout:your-app-name"
  # Agrega más servicios según necesites
)

# IDs de entornos (formato: "id:nombre:nombre-app")
# Los entornos se desplegarán en el orden listado aquí
# El nombre de la app debe coincidir con uno definido en DEPLOY_APPS
# Cada aplicación puede tener sus propios IDs de entorno
export DEPLOY_ENVIRONMENTS=(
  "ENV_ID_1:DEVELOPMENT:your-app-name"
  "ENV_ID_2:DEVELOPMENT Contact Center:your-app-name"
  "ENV_ID_3:QUALITY ASSURANCE:your-app-name"
  "ENV_ID_4:QUALITY ASSURANCE Contact Center:your-app-name"
  "ENV_ID_5:STAGING:your-app-name"
  "ENV_ID_6:STAGING Contact Center:your-app-name"
)

# Tokens de autenticación (se actualizan automáticamente al hacer deploy)
# No es necesario editarlos manualmente
export DEPLOY_CSRF_TOKEN=""
export DEPLOY_SESSION_ID=""

# ============================================
# Configuración de Git
# ============================================

# Ramas o patrones a excluir de la limpieza automática (no_branch_for_old_refs)
# Soporta nombres exactos y patrones glob (ej: "maintenance/*")
# La rama actual y main/master se excluyen siempre automáticamente
export GIT_BRANCH_EXCLUSIONS=(
  "maintenance/*"
)

# ============================================
# Configuración de Wiremock
# ============================================

# URL del servidor Wiremock
# Ejemplo: http://localhost:8080
export WIREMOCK_SERVER_URL="http://localhost:8080"

# ============================================
# Configuración de Directorios
# ============================================

# Directorio base de código (relativo a $HOME)
# Ejemplo: code
export CODE_DIR="code"

# Directorio de trabajo corporativo (relativo a $HOME/$CODE_DIR)
# Ejemplo: grupo-santander-ods
export WORK_DIR="your-work-directory"

# ============================================
# Otras configuraciones
# ============================================

# Añade aquí más variables según sea necesario
# OTRA_CONFIG="valor"
